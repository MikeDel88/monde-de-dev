DB_USER=root
DB_PASSWORD=root
DB_NAME=base

# Cle RSA 2048 bits, generee avec :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# puis copiees ici sans les lignes -----BEGIN/END----- et sans retour a la ligne :
#   grep -v -- '-----' private.pem | tr -d '\n'
#   grep -v -- '-----' public.pem | tr -d '\n'
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=