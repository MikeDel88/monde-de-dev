{
  "name": "mdd-client",
  "version": "0.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:test": "ng serve --configuration=test",
    "build": "ng build",
    "build:test": "ng build --configuration=test",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "start-server-and-test start:test http://localhost:4200 cypress:run",
    "e2e:open": "start-server-and-test start:test http://localhost:4200 cypress:open",
    "e2e:coverage": "npm run build:test && nyc instrument dist/mdd-client/browser dist/mdd-client/browser --in-place && start-server-and-test \"serve -s dist/mdd-client/browser -l tcp://0.0.0.0:4200\" http://localhost:4200 cypress:run && nyc report --reporter=lcov --reporter=text-summary",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.1.4",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@cypress/code-coverage": "^3.14.5",
    "@cypress/schematic": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "angular-eslint": "22.2.0",
    "cypress": "15.20.1",
    "eslint": "^10.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^30.0.1",
    "nyc": "^17.1.0",
    "postcss": "^8.5.26",
    "serve": "^14.2.6",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
